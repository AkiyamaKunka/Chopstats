<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9 to 11 (API 28-30, android:fullBackupContent; Android 12+
     reads data_extraction_rules.xml instead, and Android 8.1 and lower
     res/xml/backup_rules.xml). Keeps the backup-excluded local store
     (lib/services/local_store.dart, files/bitewise_local/) and
     flutter_secure_storage's shared_prefs files (the API keys, encrypted
     with a Keystore key that never leaves this phone) out of Auto Backup
     and device-to-device transfer; data_extraction_rules.xml says why.

     A cloud backup only when it is end-to-end encrypted (owner decision 5,
     2026-11-20). Each <include> takes a whole domain (path ".", so the
     includes together take what Auto Backup takes with no rules), but
     only for the transfer its requireFlags names: clientSideEncryption, a
     cloud backup encrypted with the phone's screen lock (PIN, pattern or
     password); deviceToDeviceTransfer, a transfer straight to a new
     phone, which stays as it was. A cloud backup from a phone without a
     screen lock matches no <include> and carries none of the app's files.
     The excludes hold for both.

     requireFlags came with Android 9. Android 8.1 and lower refuse any
     rule with a third attribute, and a parse that fails there half way
     leaves Android with the excludes and no includes, which a later
     backup in the same process reads as "everything else". So these
     rules live in xml-v28, and res/xml/backup_rules.xml gives those
     versions rules they can read ("provide alternate resources for
     backups being used on devices running Android 8.1 (API level 27) or
     lower", developer.android.com/identity/data/autobackup, read
     2026-11-20). -->
<full-backup-content>
    <exclude domain="file" path="bitewise_local/"/>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml"/>

    <include domain="root" path="." requireFlags="clientSideEncryption"/>
    <include domain="file" path="." requireFlags="clientSideEncryption"/>
    <include domain="database" path="." requireFlags="clientSideEncryption"/>
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption"/>
    <include domain="external" path="." requireFlags="clientSideEncryption"/>
    <include domain="device_root" path="." requireFlags="clientSideEncryption"/>
    <include domain="device_file" path="." requireFlags="clientSideEncryption"/>
    <include domain="device_database" path="." requireFlags="clientSideEncryption"/>
    <include domain="device_sharedpref" path="." requireFlags="clientSideEncryption"/>

    <include domain="root" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="file" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="sharedpref" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="external" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="device_root" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="device_file" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="device_database" path="." requireFlags="deviceToDeviceTransfer"/>
    <include domain="device_sharedpref" path="." requireFlags="deviceToDeviceTransfer"/>
</full-backup-content>
