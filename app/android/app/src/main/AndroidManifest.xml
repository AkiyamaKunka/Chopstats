<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Gemini analysis and key validation need network. Flutter auto-adds
         this ONLY to the debug/profile manifest (for hot reload), so it must
         be declared here or release builds ship with no internet at all —
         every analysis fails with "Error contacting Gemini". -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Photo intake (spec §6): read camera-roll images via photo_manager.
         API 33+ uses the granular media permission; API <=32 needs legacy
         external-storage read. WorkManager background scan needs no extra
         permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Android 14+ partial access: WITHOUT this, the "Select photos"
         option grants a TEMPORARY full READ_MEDIA_IMAGES that reads as
         authorized, so the app cannot tell it apart from a full grant and
         the watcher silently sees only the picked photos. Declaring it
         makes the limited grant persist as PermissionState.limited, which
         the toggle now detects and warns about. -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Meal-card / daily-report notifications (runtime permission, API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The OS-armed daily summary: flutter_local_notifications re-arms its
         scheduled card after a reboot (ScheduledNotificationBootReceiver
         below). WorkManager merges it in too; declared here because the
         app relies on it. Inexact alarms only, so no exact-alarm
         permission. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- WorkManager's library manifest brings FOREGROUND_SERVICE and its
         SystemForegroundService (no type) for expedited work on Android 11
         and lower and for setForeground. The app never asks for either, so
         both are stripped from the merged manifest. Its work: one periodic
         task (lib/services/photo/background.dart), and the analysis
         keep-alive's one-time job (AnalysisKeepAlive.kt, owner decision 9),
         expedited only on Android 12 and later, where JobScheduler runs it
         with no foreground service, and a plain job below that. Expedited
         work below Android 12, or setForeground, would need them back
         (manifest_gate_test). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove"/>
    <!-- Backup: everything is backed up as before except files/bitewise_local/,
         the backup-excluded local store (lib/services/local_store.dart),
         and flutter_secure_storage's files (the API keys, which no other
         phone could decrypt): res/xml/data_extraction_rules.xml on Android
         12+, res/xml-v28/backup_rules.xml on Android 9 to 11. A cloud
         backup happens only when it is end-to-end encrypted, which needs a
         screen lock (owner decision 5, 2026-11-20); on Android 9 and later
         a transfer to a new phone goes as before. Android 8.1 and lower
         cannot encrypt a backup end to end, nor tell it from a transfer:
         res/xml/backup_rules.xml gives them none of the app's data for
         either (an export still keeps a copy).
         hasFragileUserData: on Android 10+ the uninstall dialog offers to
         keep the app's data, since the meal log lives only on the phone. A
         reinstall with the same signer then finds the log. Should the
         kept key store have lost its Keystore key, AndroidSecureKeyStore
         (app_settings.dart) reads it as no key and the app asks again.
         enableOnBackInvokedCallback (owner decision 6, 2026-11-20): back
         reaches the app through Android's back callback on Android 13 and
         later, as Android 16 does by default for targetSdk 36; from
         Android 14 it comes with the gesture's progress, so the
         predictive-back page transition (lib/ui/theme/app_theme.dart)
         follows the finger. A screen with unsaved changes still asks
         before it closes (DiscardChangesGuard). At an idle root route
         Flutter leaves Back to Android: Android 13 moves the task to the
         back, but Android 14 and later do that only for a task the home
         screen started with the launcher's intent and finish any other,
         with its engine. So a task a share, the bitewise://setup link or a
         notification started keeps Flutter's callback
         (MainActivity.setFrameworkHandlesBack), and Back at its root goes
         through Flutter's SystemNavigator.pop to
         MainActivity.popSystemNavigator, which moves the task to the back,
         as on Android 12 and lower. A launcher-intent start that did not
         come from the home screen (Play's Open button) looks the same to
         the app, and Android 14 and later still finish it on such a Back.
         While a shared photo is pending or an analysis the user started is
         in flight, the shell keeps Back at the root in Flutter in every
         task (SharedPhotosBackGuard). -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:hasFragileUserData="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <!-- singleTask (review 171, C6): a share while the app runs reaches
             the running engine through onNewIntent (MainActivity.kt, then
             receive_sharing_intent's live stream). singleTop started a second
             MainActivity for a share from the sharesheet, with its own engine
             and a second set of services, in a task of its own. A share with
             no instance running still starts one, as before.
             screenOrientation portrait (owner decision 7, 2026-11-20): phones
             stay upright, like the iPhone app (Info.plist). For targetSdk 36,
             Android 16 ignores the lock on displays 600 dp and wider (tablets,
             unfolded foldables), where the width-capped layout
             (ContentWidthCap) keeps the content readable in any orientation. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- One-click server setup link (bitewise://setup?...): the
                 provisioning QR / adb / devicectl path (2026-09-28). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="bitewise" android:host="setup"/>
            </intent-filter>
            <!-- Share-sheet photo intake (spec §6, deliberate re-send path):
                 receive_sharing_intent delivers images shared to the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications' scheduled notifications (its
             README, AndroidManifest.xml setup): the daily summary card the
             OS posts at its time (zonedSchedule, inexactAllowWhileIdle),
             and its re-arming after a reboot or an app update. Alarms do
             not survive either. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- WorkManager's foreground service, stripped with its permission
             above. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove"/>
        <!-- The system Photo Picker (MainActivity.pickImages) on Android 10
             and lower (7-10 here: minSdk is 24): asks Google Play services
             to install its backported picker module. Disabled and not
             exported, a marker only; the class lives in Play services.
             Without Play services the AndroidX contract falls back to
             ACTION_OPEN_DOCUMENT itself.
             (developer.android.com/training/data-storage/shared/photopicker) -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            android:enabled="false"
            android:exported="false"
            tools:ignore="MissingClass">
            <intent-filter>
                <action android:name="com.google.android.gms.metadata.MODULE_DEPENDENCIES"/>
            </intent-filter>
            <meta-data android:name="photopicker_activity:0:required" android:value=""/>
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
